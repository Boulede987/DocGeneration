@startuml language

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<dataclass>> #FCF3CF
  BorderColor<<dataclass>> #B7950B
}
skinparam class {
  BackgroundColor<<module>> #DDEBF7
  BorderColor<<module>> #4A6FA5
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace docgen.languages.csharp {
class CSharpLanguage {
  + {static} name
  + {static} source_suffix
  + {static} views_dir
  + {static} skinparam_lines
  + {static} vocabulary
  + parse_file(SourceText) : ParsedFile[ObjectOrientedFacts]
  + enclosing_packages(str | None) : list[str | None]
  + stereotype(TypeHeader, frozenset[str]) : str | None
  # _parse_type(TypeHeader) : DeclarationWithFacts
  # _fill_class_like(TypeDecl, TypeFacts, TypeHeader)
}
class language <<module>> {
  + {static} STRUCT
  # {static} _KINDS
  # {static} _NAMESPACE_SEPARATOR
}
}

docgen.languages.csharp.CSharpLanguage --|> docgen.oo.ObjectOrientedLanguage
docgen.languages.csharp.CSharpLanguage ..> docgen.core.ParsedFile
docgen.languages.csharp.CSharpLanguage ..> docgen.core.ResolutionHints
docgen.languages.csharp.CSharpLanguage ..> docgen.core.SourceText
docgen.languages.csharp.CSharpLanguage ..> docgen.core.TypeDecl
docgen.languages.csharp.CSharpLanguage ..> docgen.oo.TypeFacts
docgen.languages.csharp.CSharpLanguage ..> docgen.languages.csharp.TypeHeader
docgen.languages.csharp.CSharpLanguage ..> docgen.core.TypeKind
docgen.languages.csharp.language ..> docgen.core.TypeKind
docgen.languages.csharp.CSharpLanguage ..> docgen.languages.csharp.vocabulary
docgen.languages.csharp.CSharpLanguage ..> docgen.oo.language
docgen.languages.csharp.CSharpLanguage ..> docgen.core.style
docgen.languages.csharp.CSharpLanguage ..> docgen.languages.csharp.declarations
docgen.languages.csharp.CSharpLanguage ..> docgen.oo.stereotypes
docgen.languages.csharp.CSharpLanguage ..> docgen.languages.csharp.members
docgen.languages.csharp.CSharpLanguage ..> docgen.clike.text_scan

@enduml