@startuml language

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<dataclass>> #FCF3CF
  BorderColor<<dataclass>> #B7950B
}
skinparam class {
  BackgroundColor<<module>> #DDEBF7
  BorderColor<<module>> #4A6FA5
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace docgen.languages.java {
class JavaLanguage {
  + {static} name
  + {static} source_suffix
  + {static} views_dir
  + {static} skinparam_lines
  + {static} vocabulary
  + parse_file(SourceText) : ParsedFile[ObjectOrientedFacts]
  # _parse_type(TypeHeader) : DeclarationWithFacts
  # _fill_class_like(TypeDecl, TypeFacts, TypeHeader)
}
class language <<module>> {
  + {static} RECORD
  # {static} _KINDS
}
}

docgen.languages.java.JavaLanguage --|> docgen.oo.ObjectOrientedLanguage
docgen.languages.java.JavaLanguage ..> docgen.oo.FieldUsage
docgen.languages.java.JavaLanguage ..> docgen.core.ParsedFile
docgen.languages.java.JavaLanguage ..> docgen.core.ResolutionHints
docgen.languages.java.JavaLanguage ..> docgen.core.SourceText
docgen.languages.java.JavaLanguage ..> docgen.core.TypeDecl
docgen.languages.java.JavaLanguage ..> docgen.oo.TypeFacts
docgen.languages.java.JavaLanguage ..> docgen.languages.java.TypeHeader
docgen.languages.java.JavaLanguage ..> docgen.core.TypeKind
docgen.languages.java.language ..> docgen.core.TypeKind

@enduml