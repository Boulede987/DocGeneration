@startuml language

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<dataclass>> #FCF3CF
  BorderColor<<dataclass>> #B7950B
}
skinparam class {
  BackgroundColor<<module>> #DDEBF7
  BorderColor<<module>> #4A6FA5
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace docgen.languages.python {
class PythonLanguage {
  + {static} name
  + {static} source_suffix
  + {static} views_dir
  + {static} skinparam_lines
  + {static} vocabulary
  + {static} hidden_bases
  + parse_file(SourceText) : ParsedFile[ObjectOrientedFacts]
}
class language <<module>> {
  + {static} PACKAGE_MODULE_STEM
  + {static} MODULE_BOX_SUFFIX
  + {static} HIDDEN_BASES
  # {static} _module_name(SourceText, set[str]) : str
}
}

docgen.languages.python.PythonLanguage --|> docgen.oo.ObjectOrientedLanguage
docgen.languages.python.PythonLanguage ..> docgen.core.ParsedFile
docgen.languages.python.PythonLanguage ..> docgen.core.SourceText
docgen.languages.python.language ..> docgen.core.SourceText

@enduml