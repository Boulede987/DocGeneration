@startuml inference

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<dataclass>> #FCF3CF
  BorderColor<<dataclass>> #B7950B
}
skinparam class {
  BackgroundColor<<module>> #DDEBF7
  BorderColor<<module>> #4A6FA5
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace docgen.oo {
class FieldFacts <<dataclass>> {
  + target : str
  + is_collection : bool
  + is_public : bool
  + is_serialized : bool
  + is_newed : bool
}
class RelationPolicy {
  + classify_field(FieldFacts) : tuple[str, RelationLevel]
}
class inference <<module>> {
  # {static} _superclasses(TypeFacts) : list[str]
  + {static} inherited_names(TypeFacts) : set[str]
  + {static} inheritance_relations(TypeFacts, frozenset[str]) : list[Relation]
  # {static} _merge(FieldFacts | None, str, bool, bool, bool, bool) : FieldFacts
  # {static} _merged_field_facts(TypeFacts, set[str], TypeVocabulary) : dict[str, FieldFacts]
  + {static} usage_relations(TypeFacts, set[str], RelationPolicy, TypeVocabulary) : list[Relation]
  + {static} relations_of(list[TypeFacts], set[str], RelationPolicy, TypeVocabulary, frozenset[str]) : list[Relation]
}
}

docgen.oo.RelationPolicy ..> docgen.oo.FieldFacts
docgen.oo.RelationPolicy ..> docgen.core.RelationLevel
docgen.oo.inference ..> docgen.oo.FieldFacts
docgen.oo.inference ..> docgen.core.Relation
docgen.oo.inference ..> docgen.core.RelationLevel
docgen.oo.inference ..> docgen.oo.RelationPolicy
docgen.oo.inference ..> docgen.oo.TypeFacts
docgen.oo.inference ..> docgen.oo.TypeVocabulary
docgen.oo.RelationPolicy ..> docgen.core.relations
docgen.oo.inference ..> docgen.core.model
docgen.oo.inference ..> docgen.core.relations

@enduml