@startuml text_scan

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<dataclass>> #FCF3CF
  BorderColor<<dataclass>> #B7950B
}
skinparam class {
  BackgroundColor<<module>> #DDEBF7
  BorderColor<<module>> #4A6FA5
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace docgen.clike {
class text_scan <<module>> {
  # {static} _BLOCK_COMMENT
  # {static} _LINE_COMMENT
  + {static} BLOCK_OPEN
  + {static} BLOCK_CLOSE
  + {static} STATEMENT_END
  + {static} LIST_SEPARATOR
  # {static} _ANY_OPENING_BRACKET
  # {static} _ANY_CLOSING_BRACKET
  # {static} _TYPE_ARGUMENT_OPENING
  # {static} _TYPE_ARGUMENT_CLOSING
  + {static} PROPERTY_PLACEHOLDER
  + {static} BODY_PLACEHOLDER
  + {static} strip_c_comments(str) : str
  + {static} close_brace(str, int) : int
  + {static} split_top_level(str, str) : tuple[str, str]
  + {static} split_by_comma(str) : list[str]
  # {static} _braced_statement(str, str, re.Pattern[str], re.Pattern[str] | None) : str | None
  + {static} flatten(str, re.Pattern[str], re.Pattern[str] | None) : list[str]
}
}


@enduml