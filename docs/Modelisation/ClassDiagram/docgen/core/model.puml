@startuml model

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<dataclass>> #FCF3CF
  BorderColor<<dataclass>> #B7950B
}
skinparam class {
  BackgroundColor<<module>> #DDEBF7
  BorderColor<<module>> #4A6FA5
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace docgen.core {
enum TypeKind <<enum>> {
  CLASS
  INTERFACE
  ENUM
}
enum Visibility <<enum>> {
  PUBLIC
  PRIVATE
  PROTECTED
  PACKAGE
}
enum MemberKind <<enum>> {
  FIELD
  PROPERTY
  METHOD
}
class Member <<dataclass>> {
  + kind : MemberKind
  + name : str
  + visibility : Visibility
  + is_static : bool
  + is_abstract : bool
  + type : str | None
  + params : str[*]
}
class TypeDecl <<dataclass>> {
  + name : str
  + kind : TypeKind
  + stereotype : str | None
  + is_abstract : bool
  + members : Member[*]
  + enum_values : str[*]
  + bare_name : str
}
class SourceText <<dataclass>> {
  + relative_path : Path
  + text : str
  + stem : str
}
class ResolutionHints <<dataclass>> {
  + type_imports : dict[str, str]
  + namespace_imports : str[*]
}
class ParsedFile <<dataclass>> {
  + stem : str
  + package : str | None
  + declarations : TypeDecl[*]
  + hints : ResolutionHints
  + facts : FactsT | None
  + notes : str[*]
}
class model <<module>> {
  + {static} TYPE_PARAMETERS_START
  + {static} bare_type_name(str) : str
}
}

docgen.core.Member *--> docgen.core.MemberKind
docgen.core.Member *--> docgen.core.Visibility
docgen.core.TypeDecl *--> "0..*" docgen.core.Member
docgen.core.TypeDecl *--> docgen.core.TypeKind
docgen.core.ParsedFile *--> docgen.core.ResolutionHints
docgen.core.ParsedFile *--> "0..*" docgen.core.TypeDecl

@enduml