@startuml pipeline

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<dataclass>> #FCF3CF
  BorderColor<<dataclass>> #B7950B
}
skinparam class {
  BackgroundColor<<module>> #DDEBF7
  BorderColor<<module>> #4A6FA5
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace docgen.core {
class SourceFile <<dataclass>> {
  + path : Path
  + relative_path : Path
}
class RunSummary <<dataclass>> {
  + generated : int
  + skipped : Path[*]
  + errors : dict[Path, str]
  + package_count : int
  + excluded : int
  + notes : dict[Path, list[str]]
  + link_error : str | None
  + has_errors : bool
  + record_error(SourceFile, Exception)
}
class pipeline <<module>> {
  + {static} SOURCE_ENCODING
  + {static} CURRENT_FOLDER_PREFIX
  # {static} _error_text(Exception) : str
  + {static} normalized_pattern(str) : str
  # {static} _is_excluded(SourceFile, Sequence[str]) : bool
  + {static} discover_sources(Sequence[Path], str) : list[SourceFile]
  + {static} build_file_diagram(ParsedFile, list[Relation], ProjectIndex, Language) : FileDiagram
  # {static} _end_packages(Relation, ParsedFile, ProjectIndex, Language) : EndPackages
  # {static} _parse_source(Language, SourceFile) : ParsedFile
  # {static} _parse_sources(Language, list[SourceFile], RunSummary) : dict[SourceFile, ParsedFile]
  # {static} _write_diagrams(Language, dict[SourceFile, ParsedFile], Mapping[ParsedFile, list[Relation]], Project, Path, RunSummary) : list[FileDiagram]
  # {static} _link(Language, Project, RunSummary) : Mapping[ParsedFile, list[Relation]]
  + {static} run(Language, Sequence[Path], Path, Sequence[str]) : RunSummary
}
}


@enduml