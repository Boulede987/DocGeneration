namespace docgen.languages.rust {
class TypeRef <<dataclass>> {
  + module : str | None
  + name : str
}
class Declared <<dataclass>> {
  + parsed : ParsedFile[RustFacts]
  + declaration : TypeDecl
  + facts : RustTypeFacts
}
class ModuleBox <<dataclass>> {
  + ref : TypeRef
  + member_names : str[*]
}
class CrateIndex {
  # _declared : dict[TypeRef, Declared]
  # _boxes : dict[str | None, ModuleBox]
  # _drawn_in : dict[str, str | None]
  # _index_file(ParsedFile[RustFacts])
  # _module(list[str]) : str | None
  + declared(TypeRef) : Declared | None
  # _bound_path(str, RustFacts) : list[str] | None
  # _absolute_path(list[str], RustFacts) : list[str] | None
  # _glob_modules(RustFacts) : list[str | None]
  + resolve_type(str, RustFacts) : TypeRef | None
  # _box_declaring(str | None, str) : TypeRef | None
  + resolve_item(ItemUse, RustFacts) : TypeRef | None
}
class index <<module>> {
  # {static} _MODULE_KEYWORDS
  # {static} _module_key(list[str]) : str | None
  # {static} _absolute(list[str], str | None, tuple[str, ...]) : list[str] | None
}
}

docgen.languages.rust.Declared *--> docgen.core.ParsedFile
docgen.languages.rust.Declared *--> docgen.languages.rust.RustFacts
docgen.languages.rust.Declared *--> docgen.languages.rust.RustTypeFacts
docgen.languages.rust.Declared *--> docgen.core.TypeDecl
docgen.languages.rust.ModuleBox *--> docgen.languages.rust.TypeRef
docgen.languages.rust.CrateIndex *--> docgen.languages.rust.Declared
docgen.languages.rust.CrateIndex *--> docgen.languages.rust.ModuleBox
docgen.languages.rust.CrateIndex *--> docgen.languages.rust.TypeRef

@enduml