namespace docgen.core {
enum RelationLevel <<enum>> {
  INHERITANCE
  STRONG
  WEAK
}
class Relation <<dataclass>> {
  + source : str
  + arrow : str
  + target : str
  + level : RelationLevel
  + multiplicity : str | None
  + render(str, str) : str
}
class FieldFacts <<dataclass>> {
  + target : str
  + is_collection : bool
  + is_public : bool
  + is_serialized : bool
  + is_newed : bool
}
class RelationPolicy {
  + classify_field(FieldFacts) : tuple[str, RelationLevel]
}
class relations <<module>> {
  + {static} INHERITS
  + {static} REALIZES
  + {static} COMPOSES
  + {static} ASSOCIATES
  + {static} DEPENDS
  + {static} MANY
  # {static} _superclasses(TypeDecl) : list[str]
  + {static} inherited_names(TypeDecl) : set[str]
  + {static} inheritance_relations(TypeDecl, frozenset[str]) : list[Relation]
  # {static} _merge(FieldFacts | None, str, bool, bool, bool, bool) : FieldFacts
  # {static} _merged_field_facts(TypeDecl, set[str], TypeVocabulary) : dict[str, FieldFacts]
  + {static} usage_relations(TypeDecl, set[str], set[str], RelationPolicy, TypeVocabulary) : list[Relation]
}
}

