namespace docgen.languages.python {
class PythonTypeFacts <<dataclass>> {
  + module_uses : ModuleUse[*]
  + module_path : str | None
}
class ModuleIdentity <<dataclass>> {
  + box_name : str
  + module_path : str | None
}
class declarations <<module>> {
  + {static} ENUM_BASES
  + {static} PROTOCOL_BASE
  + {static} ABSTRACT_BASE
  + {static} GENERIC_BASE
  + {static} OBJECT_BASE
  + {static} DATACLASS_MODIFIER
  + {static} DATACLASS_STEREOTYPE
  # {static} _ENUM_CONFIGURATION_PREFIX
  # {static} _classes_in(list[ast.stmt]) : Iterator[ast.ClassDef]
  + {static} base_names(ast.ClassDef) : list[str]
  # {static} _kind(list[str]) : TypeKind
  # {static} _modifiers(ast.ClassDef, list[str]) : frozenset[str]
  # {static} _enum_member_names(ast.stmt) : list[str]
  # {static} _enum_values(ast.ClassDef) : list[str]
  # {static} _stereotype(frozenset[str]) : str | None
  # {static} _declaration(ast.ClassDef, TypeVocabulary, ImportedNames) : DeclarationWithFacts
  + {static} class_declarations(ast.Module, TypeVocabulary, ImportedNames) : list[DeclarationWithFacts]
  + {static} module_declaration(ast.Module, ModuleIdentity, TypeVocabulary, ImportedNames) : DeclarationWithFacts | None
}
}

docgen.languages.python.PythonTypeFacts --|> docgen.oo.TypeFacts
docgen.languages.python.PythonTypeFacts *--> "0..*" docgen.languages.python.ModuleUse
docgen.languages.python.declarations ..> docgen.languages.python.ImportedNames
docgen.languages.python.declarations ..> docgen.languages.python.ModuleIdentity
docgen.languages.python.declarations ..> docgen.languages.python.PythonTypeFacts
docgen.languages.python.declarations ..> docgen.core.TypeDecl
docgen.languages.python.declarations ..> docgen.core.TypeKind
docgen.languages.python.declarations ..> docgen.oo.TypeVocabulary
docgen.languages.python.declarations ..> docgen.languages.python.syntax
docgen.languages.python.declarations ..> docgen.languages.python.members
docgen.languages.python.declarations ..> docgen.oo.stereotypes
docgen.languages.python.declarations ..> docgen.oo.language
docgen.languages.python.declarations ..> docgen.languages.python.usages
docgen.languages.python.declarations ..> docgen.languages.python.vocabulary