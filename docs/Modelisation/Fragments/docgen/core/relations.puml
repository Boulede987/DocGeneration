namespace docgen.core {
enum RelationLevel <<enum>> {
  INHERITANCE
  STRONG
  WEAK
}
enum PackageLookup <<enum>> {
  BY_NAME
}
class Relation <<dataclass>> {
  + source : str
  + arrow : str
  + target : str
  + level : RelationLevel
  + multiplicity : str | None
  + target_package : str | None | PackageLookup
  + render(str, str) : str
}
class relations <<module>> {
  + {static} INHERITS
  + {static} REALIZES
  + {static} COMPOSES
  + {static} AGGREGATES
  + {static} ASSOCIATES
  + {static} DEPENDS
  + {static} MANY
}
}

docgen.core.Relation *--> docgen.core.PackageLookup
docgen.core.Relation *--> docgen.core.RelationLevel