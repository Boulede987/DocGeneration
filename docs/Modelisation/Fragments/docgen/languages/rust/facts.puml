namespace docgen.languages.rust {
enum Ownership <<enum>> {
  OWNED
  SHARED
}
class HeldType <<dataclass>> {
  + name : str
  + ownership : Ownership
  + is_collection : bool
}
class ItemUse <<dataclass>> {
  + module_path : str | None
  + name : str
}
class UseBinding <<dataclass>> {
  + local_name : str
  + path : tuple[str, ...]
  + is_glob : bool
  + scope : tuple[str, ...]
}
class RustTypeFacts <<dataclass>> {
  + name : str
  + fields : HeldType[*]
  + supertraits : str[*]
  + signature_types : str[*]
  + body_types : str[*]
  + item_uses : ItemUse[*]
}
class ImplBlock <<dataclass>> {
  + target : str
  + trait : str | None
  + members : Member[*]
  + signature_types : str[*]
  + body_types : str[*]
  + item_uses : ItemUse[*]
}
class RustFacts <<dataclass>> {
  + module_path : str | None
  + types : RustTypeFacts[*]
  + impl_blocks : ImplBlock[*]
  + uses : UseBinding[*]
  + box_name : str | None
  + inline_modules : str[*]
}
}

docgen.languages.rust.HeldType *--> docgen.languages.rust.Ownership
docgen.languages.rust.RustTypeFacts *--> "0..*" docgen.languages.rust.HeldType
docgen.languages.rust.RustTypeFacts *--> "0..*" docgen.languages.rust.ItemUse
docgen.languages.rust.ImplBlock *--> "0..*" docgen.languages.rust.ItemUse
docgen.languages.rust.ImplBlock *--> "0..*" docgen.core.Member
docgen.languages.rust.RustFacts *--> "0..*" docgen.languages.rust.ImplBlock
docgen.languages.rust.RustFacts *--> "0..*" docgen.languages.rust.RustTypeFacts
docgen.languages.rust.RustFacts *--> "0..*" docgen.languages.rust.UseBinding