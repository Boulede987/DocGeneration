@startuml unity

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<dataclass>> #FCF3CF
  BorderColor<<dataclass>> #B7950B
}
skinparam class {
  BackgroundColor<<module>> #DDEBF7
  BorderColor<<module>> #4A6FA5
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

skinparam class {
  BackgroundColor<<external>> #EAECEE
  BorderColor<<external>> #839192
}

namespace docgen.languages.unity {
class UnityRelationPolicy {
  + scriptable_objects : str[*]
  + classify_field(FieldFacts) : tuple[str, RelationLevel]
}
class UnityLanguage {
  + {static} name
  + {static} skinparam_lines
  + {static} vocabulary : TypeVocabulary
  + {static} hidden_bases
  + stereotype(TypeHeader, frozenset[str]) : str | None
  + relation_policy(Project[ObjectOrientedFacts]) : RelationPolicy
}
class language <<module>> {
  + {static} SCRIPTABLE_OBJECT
  + {static} UNITY_BASES
  + {static} UNITY_PRIMITIVES
  + {static} SCRIPTABLE_OBJECT_STYLE : StereotypeStyle
  + {static} SCRIPTABLE_OBJECT_STEREOTYPE
  + {static} scriptable_object_subclasses(Project[ObjectOrientedFacts]) : set[str]
}
}
class docgen.core.Project <<external>> [[core.svg]] {
}
class docgen.core.RelationLevel <<external>> [[core.svg]] {
}
class docgen.core.StereotypeStyle <<external>> [[core.svg]] {
}
class docgen.core.model <<external>> [[core.svg]] {
}
class docgen.core.relations <<external>> [[core.svg]] {
}
class docgen.core.style <<external>> [[core.svg]] {
}
class docgen.languages.csharp.CSharpLanguage <<external>> [[csharp.svg]] {
}
class docgen.languages.csharp.TypeHeader <<external>> [[csharp.svg]] {
}
class docgen.languages.csharp.vocabulary <<external>> [[csharp.svg]] {
}
class docgen.oo.FieldFacts <<external>> [[oo.svg]] {
}
class docgen.oo.RelationPolicy <<external>> [[oo.svg]] {
}
class docgen.oo.language <<external>> [[oo.svg]] {
}

docgen.languages.unity.UnityRelationPolicy --|> docgen.oo.RelationPolicy
docgen.languages.unity.UnityLanguage --|> docgen.languages.csharp.CSharpLanguage
docgen.languages.unity.UnityRelationPolicy ..> docgen.oo.FieldFacts
docgen.languages.unity.UnityRelationPolicy ..> docgen.core.RelationLevel
docgen.languages.unity.UnityLanguage ..> docgen.core.Project
docgen.languages.unity.UnityLanguage ..> docgen.oo.RelationPolicy
docgen.languages.unity.UnityLanguage ..> docgen.languages.csharp.TypeHeader
docgen.languages.unity.UnityLanguage ..> docgen.languages.unity.UnityRelationPolicy
docgen.languages.unity.language ..> docgen.core.Project
docgen.languages.unity.language ..> docgen.core.StereotypeStyle
docgen.languages.unity.UnityRelationPolicy ..> docgen.core.relations
docgen.languages.unity.UnityLanguage ..> docgen.core.style
docgen.languages.unity.UnityLanguage ..> docgen.languages.csharp.vocabulary
docgen.languages.unity.UnityLanguage ..> docgen.oo.language
docgen.languages.unity.language ..> docgen.oo.language
docgen.languages.unity.language ..> docgen.core.model
docgen.languages.unity.language ..> docgen.languages.csharp.vocabulary

@enduml