namespace docgen.languages.csharp {
class TypeHeader <<dataclass>> {
  + modifiers : str
  + kind : str
  + name : str
  + base_class : str | None
  + interfaces : str[*]
  + body : str
}
class declarations <<module>> {
  + {static} NAMESPACE_RE
  + {static} USING_RE
  + {static} TYPE_DECL
  # {static} _GENERIC_CONSTRAINTS
  # {static} _INTERFACE_NAME
  # {static} _VERBATIM_STRING
  # {static} _STRING_LITERAL
  # {static} _CHAR_LITERAL
  + {static} EMPTY_STRING
  + {static} EMPTY_CHAR
  + {static} strip_strings(str) : str
  + {static} parse_namespace(str) : str | None
  + {static} parse_usings(str) : set[str]
  # {static} _supertypes(str) : tuple[str | None, list[str]]
  + {static} find_type_headers(str) : list[TypeHeader]
}
class CSharpLanguage {
  + {static} name
  + {static} source_suffix
  + {static} views_dir
  + {static} skinparam_lines
  + {static} vocabulary
  + parse_file(SourceText) : ParsedFile
  + enclosing_packages(str | None) : list[str | None]
  # _declaration(TypeHeader) : TypeDecl
  # _fill_class_like(TypeDecl, TypeHeader)
}
class language <<module>> {
  # {static} _KINDS
  # {static} _NAMESPACE_SEPARATOR
}
class MemberTypes <<dataclass>> {
  + field_usages : FieldUsage[*]
  + signature_types : str[*]
}
class members <<module>> {
  + {static} MODIFIERS_PATTERN
  + {static} NESTED_TYPE
  + {static} PROPERTY_INNER
  + {static} ATTRIBUTES
  + {static} PROP_RE
  + {static} METHOD_RE
  + {static} FIELD_RE
  # {static} _INTERFACE_METHOD
  # {static} _INTERFACE_PROPERTY
  # {static} _INTERFACE_DECLARATION_NOISE
  # {static} _PARAMETER_MODIFIER
  # {static} _ENUM_ATTRIBUTE
  # {static} _ENUM_VALUE_ASSIGNMENT
  # {static} _ENUM_SEPARATORS
  # {static} _IDENTIFIER
  # {static} _VISIBILITY_RULES
  # {static} _NO_RETURN_TYPES
  # {static} _SERIALIZED_ATTRIBUTE
  # {static} _PROPERTY_MARK
  # {static} _PUBLIC
  # {static} _ABSTRACT
  # {static} _STATIC_KEYWORDS
  # {static} _CALL_OPEN
  # {static} _KIND_ORDER
  # {static} _param_types(str) : list[str]
  # {static} _statements(str) : list[str]
  # {static} _typed_member(MemberKind, re.Match[str], str | None) : Member
  # {static} _parse_member(str, str, TypeVocabulary) : Member | None
  + {static} class_members(str, str, TypeVocabulary) : list[Member]
  # {static} _interface_member(str) : Member | None
  + {static} interface_members(str) : list[Member]
  + {static} enum_values(str) : list[str]
  # {static} _field_usage(str, re.Match[str]) : FieldUsage
  # {static} _add_member_types(str, str, MemberTypes)
  + {static} member_types(str, str) : MemberTypes
  # {static} _method_bodies(str) : Iterator[str]
  + {static} body_types(str) : list[str]
  + {static} newed_types(str) : list[str]
}
class vocabulary <<module>> {
  + {static} PRIMITIVES
  + {static} COLLECTION_WRAPPERS
  + {static} CSHARP_VOCABULARY : TypeVocabulary
  + {static} STRUCT_STYLE : StereotypeStyle
}
}
class docgen.core.FieldUsage <<external>> [[core.svg]] {
}
class docgen.core.Language <<external>> [[core.svg]] {
}

docgen.languages.csharp.CSharpLanguage --|> docgen.core.Language
docgen.languages.csharp.MemberTypes *--> "0..*" docgen.core.FieldUsage

