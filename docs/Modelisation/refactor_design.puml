@startuml refactor_design

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<dataclass>> #FCF3CF
  BorderColor<<dataclass>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace docgen.core {
class CommandLine <<dataclass>> {
  + src_dirs : Path[*]
  + output_base : Path
}
class FileDiagram <<dataclass>> {
  + stem : str
  + package : str | None
  + inner_lines : str[*]
  + relations : Relation[*]
  + name_packages : dict[str, str | None]
  + base_relations() : list[Relation]
  + full_relations() : list[Relation]
  + qualified_name(str) : str
  + render_relations(list[Relation]) : list[str]
}
class FileOutputPaths <<dataclass>> {
  + base : Path
  + base_fragment : Path
  + full : Path
  + full_fragment : Path
  + {static} under(Path, Path) : FileOutputPaths
}
abstract class Language <<abstract>> {
  + name : str
  + source_suffix : str
  + views_dir : str
  + skinparam_lines : str[*]
  + vocabulary : TypeVocabulary
  + hidden_bases : str[*]
  + {abstract} parse_file(SourceText) : ParsedFile
  + enclosing_packages(str | None) : list[str | None]
  + class_stereotype(TypeDecl) : str | None
  + relation_policy(list[ParsedFile]) : RelationPolicy
}
enum TypeKind <<enum>> {
  CLASS
  INTERFACE
  ENUM
  RECORD
  STRUCT
}
enum Visibility <<enum>> {
  PUBLIC
  PRIVATE
  PROTECTED
  PACKAGE
}
enum MemberKind <<enum>> {
  FIELD
  PROPERTY
  METHOD
}
class Member <<dataclass>> {
  + kind : MemberKind
  + name : str
  + visibility : Visibility
  + is_static : bool
  + is_abstract : bool
  + type : str | None
  + params : str[*]
}
class FieldUsage <<dataclass>> {
  + type_text : str
  + is_public : bool
  + is_serialized : bool
}
class TypeDecl <<dataclass>> {
  + name : str
  + kind : TypeKind
  + modifiers : str[*]
  + base_class : str | None
  + interfaces : str[*]
  + members : Member[*]
  + enum_values : str[*]
  + field_usages : FieldUsage[*]
  + signature_types : str[*]
  + body_types : str[*]
  + newed_types : str[*]
  + additional_bases : str[*]
  + bare_name : str
  + is_abstract : bool
  + is_static : bool
  + has_usages : bool
}
class SourceText <<dataclass>> {
  + relative_path : Path
  + text : str
  + stem : str
}
class ResolutionHints <<dataclass>> {
  + type_imports : dict[str, str]
  + namespace_imports : str[*]
}
class ParsedFile <<dataclass>> {
  + stem : str
  + package : str | None
  + declarations : TypeDecl[*]
  + hints : ResolutionHints
}
class _ViewVariant <<dataclass>> {
  + dir_suffix : str
  + select_relations : RelationSelector
}
class _PackageIndex <<dataclass>> {
  + files_by_package : dict[str | None, list[FileDiagram]]
  + file_names : dict[str | None, str]
  + sorted_packages() : list[str | None]
  + link(str | None) : str
}
class SourceFile <<dataclass>> {
  + path : Path
  + relative_path : Path
}
class RunSummary <<dataclass>> {
  + generated : int
  + skipped : Path[*]
  + errors : dict[Path, str]
  + package_count : int
  + record_error(SourceFile, Exception)
}
enum RelationLevel <<enum>> {
  INHERITANCE
  STRONG
  WEAK
}
class Relation <<dataclass>> {
  + source : str
  + arrow : str
  + target : str
  + level : RelationLevel
  + multiplicity : str | None
  + render(str, str) : str
}
class FieldFacts <<dataclass>> {
  + target : str
  + is_collection : bool
  + is_public : bool
  + is_serialized : bool
  + is_newed : bool
}
class RelationPolicy {
  + classify_field(FieldFacts) : tuple[str, RelationLevel]
}
class ProjectIndex {
  # _packages_by_name : dict[str, set[str | None]]
  + known_types() : set[str]
  + packages_of(str) : set[str | None]
}
class StereotypeStyle <<dataclass>> {
  + stereotype : str | None
  + background : str
  + border : str
  + lines() : list[str]
}
class TypeVocabulary <<dataclass>> {
  + primitives : str[*]
  + collection_wrappers : str[*]
  + type_argument_brackets : tuple[str, str]
  + __post_init__()
  # _wrapper(str) : str
  + is_collection(str) : bool
  + uml_type(str) : str
  + type_names(str) : set[str]
}
}
namespace docgen.languages.csharp {
class TypeHeader <<dataclass>> {
  + modifiers : str
  + kind : str
  + name : str
  + base_class : str | None
  + interfaces : str[*]
  + body : str
}
class CSharpLanguage {
  + {static} name
  + {static} source_suffix
  + {static} views_dir
  + {static} skinparam_lines
  + {static} vocabulary
  + parse_file(SourceText) : ParsedFile
  + enclosing_packages(str | None) : list[str | None]
  # _declaration(TypeHeader) : TypeDecl
  # _fill_class_like(TypeDecl, TypeHeader)
}
class MemberTypes <<dataclass>> {
  + field_usages : FieldUsage[*]
  + signature_types : str[*]
}
}
namespace docgen.languages.java {
class TypeHeader <<dataclass>> {
  + modifiers : str
  + kind : str
  + name : str
  + base_class : str | None
  + interfaces : str[*]
  + record_params : str | None
  + body : str
}
class JavaLanguage {
  + {static} name
  + {static} source_suffix
  + {static} views_dir
  + {static} skinparam_lines
  + {static} vocabulary
  + parse_file(SourceText) : ParsedFile
  # _declaration(TypeHeader) : TypeDecl
  # _fill_class_like(TypeDecl, TypeHeader)
}
class MemberTypes <<dataclass>> {
  + field_usages : FieldUsage[*]
  + signature_types : str[*]
}
}
namespace docgen.languages.python {
class PythonLanguage {
  + {static} name
  + {static} source_suffix
  + {static} views_dir
  + {static} skinparam_lines
  + {static} vocabulary
  + {static} hidden_bases
  + parse_file(SourceText) : ParsedFile
  + class_stereotype(TypeDecl) : str | None
}
class Attribute <<dataclass>> {
  + name : str
  + type_text : str | None
  + is_static : bool
}
class _UnquoteForwardReferences {
  + visit_Constant(ast.Constant) : ast.AST
  + visit_Subscript(ast.Subscript) : ast.AST
}
}
namespace docgen.languages.unity {
class UnityRelationPolicy {
  + scriptable_objects : str[*]
  + classify_field(FieldFacts) : tuple[str, RelationLevel]
}
class UnityLanguage {
  + {static} name
  + {static} skinparam_lines
  + {static} vocabulary : TypeVocabulary
  + {static} hidden_bases
  + class_stereotype(TypeDecl) : str | None
  + relation_policy(list[ParsedFile]) : RelationPolicy
}
}

docgen.core.FileDiagram *--> "0..*" docgen.core.Relation
docgen.core.FileDiagram ..> docgen.core.RelationLevel
docgen.core.Language *--> docgen.core.TypeVocabulary
docgen.core.Language ..> docgen.core.ParsedFile
docgen.core.Language ..> docgen.core.RelationPolicy
docgen.core.Language ..> docgen.core.SourceText
docgen.core.Language ..> docgen.core.TypeDecl
docgen.core.Member *--> docgen.core.MemberKind
docgen.core.Member *--> docgen.core.Visibility
docgen.core.TypeDecl *--> "0..*" docgen.core.FieldUsage
docgen.core.TypeDecl *--> "0..*" docgen.core.Member
docgen.core.TypeDecl *--> docgen.core.TypeKind
docgen.core.ParsedFile *--> docgen.core.ResolutionHints
docgen.core.ParsedFile *--> "0..*" docgen.core.TypeDecl
docgen.core._PackageIndex *--> docgen.core.FileDiagram
docgen.core.RunSummary ..> docgen.core.SourceFile
docgen.core.Relation *--> docgen.core.RelationLevel
docgen.core.RelationPolicy ..> docgen.core.FieldFacts
docgen.core.RelationPolicy ..> docgen.core.RelationLevel
docgen.languages.csharp.CSharpLanguage --|> docgen.core.Language
docgen.languages.csharp.CSharpLanguage ..> docgen.core.ParsedFile
docgen.languages.csharp.CSharpLanguage ..> docgen.core.ResolutionHints
docgen.languages.csharp.CSharpLanguage ..> docgen.core.SourceText
docgen.languages.csharp.CSharpLanguage ..> docgen.core.TypeDecl
docgen.languages.csharp.CSharpLanguage ..> docgen.languages.csharp.TypeHeader
docgen.languages.csharp.CSharpLanguage ..> docgen.core.TypeKind
docgen.languages.csharp.MemberTypes *--> "0..*" docgen.core.FieldUsage
docgen.languages.java.JavaLanguage --|> docgen.core.Language
docgen.languages.java.JavaLanguage ..> docgen.core.FieldUsage
docgen.languages.java.JavaLanguage ..> docgen.core.ParsedFile
docgen.languages.java.JavaLanguage ..> docgen.core.ResolutionHints
docgen.languages.java.JavaLanguage ..> docgen.core.SourceText
docgen.languages.java.JavaLanguage ..> docgen.core.TypeDecl
docgen.languages.java.JavaLanguage ..> docgen.languages.java.TypeHeader
docgen.languages.java.JavaLanguage ..> docgen.core.TypeKind
docgen.languages.java.MemberTypes *--> "0..*" docgen.core.FieldUsage
docgen.languages.python.PythonLanguage --|> docgen.core.Language
docgen.languages.python.PythonLanguage ..> docgen.core.ParsedFile
docgen.languages.python.PythonLanguage ..> docgen.core.SourceText
docgen.languages.python.PythonLanguage ..> docgen.core.TypeDecl
docgen.languages.python._UnquoteForwardReferences --|> NodeTransformer
docgen.languages.unity.UnityRelationPolicy --|> docgen.core.RelationPolicy
docgen.languages.unity.UnityLanguage --|> docgen.languages.csharp.CSharpLanguage
docgen.languages.unity.UnityRelationPolicy ..> docgen.core.FieldFacts
docgen.languages.unity.UnityRelationPolicy ..> docgen.core.RelationLevel
docgen.languages.unity.UnityLanguage ..> docgen.core.ParsedFile
docgen.languages.unity.UnityLanguage ..> docgen.core.RelationPolicy
docgen.languages.unity.UnityLanguage ..> docgen.core.TypeDecl
docgen.languages.unity.UnityLanguage ..> docgen.languages.unity.UnityRelationPolicy

@enduml