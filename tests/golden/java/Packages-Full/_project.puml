@startuml _project

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<record>> #FCF3CF
  BorderColor<<record>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

namespace com.shop.model {
class Category {
  - products : Product[*]
  - parent : Category
  + path() : Path
}
class Path <<static>> {
  - segments : String[*]
}
abstract class Entity <<abstract>> {
  - id : long
  # {abstract} validate()
  + id() : long
}
class Money <<record>> {
  + cents : long
  + currency : Currency
  + {static} ZERO : Money
  + plus(Money) : Money
}
enum Currency <<enum>> {
  EUR
  USD
}
interface Priced <<interface>> {
  + {static} MAX_DISCOUNT_PERCENT : int
  + price() : Money
  + isFree() : boolean
  + of(Money) : Priced
}
class Product {
  + {static} DEFAULT_NAME : String
  - name : String
  - price : Money
  # tags : Tag[*]
  + price() : Money
  + retag(Tag[])
  + compareTo(Product) : int
}
enum Tag <<enum>> {
  NEW
  LIMITED
}
}
namespace com.shop.service {
class OrderService {
  - products : Repository<Product>
  + ordersById : Map<String, Order>
  - gateway : PaymentGateway
  + place(Product, int) : Order
  + close()
}
class Order <<record>> {
  + product : Product
  + quantity : int
  + total : Money
  + id() : String
}
}
namespace com.shop.util {
class InMemoryRepository<T> {
  - items : T[*]
  - {static} instances : int
  + find(long) : Optional<T>
  + all() : List<T>
  + save(T)
}
class Counter <<static>> {
  - {static} count : int
  ~ {static} increment()
}
interface Repository<T> <<interface>> {
  + find(long) : Optional<T>
  + all() : List<T>
  + save(T) : void
}
}
class App {
  + {static} main(String[])
}
namespace org.vendor.pay {
interface PaymentGateway <<interface>> {
  + charge(long) : boolean
}
}

com.shop.model.Category ..> com.shop.model.Path
com.shop.model.Money *--> com.shop.model.Currency
com.shop.model.Product --|> com.shop.model.Entity
com.shop.model.Product ..|> Comparable
com.shop.model.Product ..|> com.shop.model.Priced
com.shop.model.Product --> com.shop.model.Money
com.shop.model.Product --> "0..*" com.shop.model.Tag
com.shop.service.OrderService --|> BaseService
com.shop.service.OrderService ..|> AutoCloseable
com.shop.service.Order *--> com.shop.model.Money
com.shop.service.Order *--> com.shop.model.Product
com.shop.service.OrderService --> org.vendor.pay.PaymentGateway
com.shop.service.OrderService --> com.shop.model.Product
com.shop.service.OrderService --> com.shop.util.Repository
com.shop.service.OrderService ..> com.shop.model.Money
com.shop.service.OrderService ..> com.shop.service.Order
com.shop.util.InMemoryRepository ..|> com.shop.util.Repository
com.shop.util.InMemoryRepository ..> com.shop.util.Counter
App ..> com.shop.util.InMemoryRepository
App ..> com.shop.service.OrderService

@enduml