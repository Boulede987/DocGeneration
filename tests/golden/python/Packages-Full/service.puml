@startuml service

skinparam classAttributeIconSize 0
skinparam shadowing false

skinparam class {
  BackgroundColor<<interface>> #D6EAF8
  BorderColor<<interface>> #2E86C1
}
skinparam class {
  BackgroundColor<<abstract>> #E8DAEF
  BorderColor<<abstract>> #8E44AD
}
skinparam class {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class {
  BackgroundColor<<dataclass>> #FCF3CF
  BorderColor<<dataclass>> #B7950B
}
skinparam class {
  BackgroundColor<<static>> #a7faa0
  BorderColor<<static>> #38d610
}
skinparam class {
  BackgroundColor<<enum>> #F5B7B1
  BorderColor<<enum>> #C0392B
}

skinparam class {
  BackgroundColor<<external>> #EAECEE
  BorderColor<<external>> #839192
}

namespace shop.service {
interface Repository <<interface>> {
  + find(str) : Optional[Product]
  + save(Product)
}
class Auditable {
  + audit() : list[str]
}
class BaseService {
  + {static} name
}
class OrderService {
  + repository : Repository
  - __orders : dict[str, Order]
  + gateway : PaymentGateway
  + history
  + {static} total(list[Product]) : Money
  + {static} create(Repository) : OrderService
  # _check(Product) : bool
}
class Order {
  + product : Product
  + validate()
}
}
class shop.model.Entity <<external>> [[model.svg]] {
}
class shop.model.Money <<external>> [[model.svg]] {
}
class shop.model.Product <<external>> [[model.svg]] {
}
class shop.util.Validator <<external>> [[util.svg]] {
}

shop.service.OrderService --|> shop.service.BaseService
shop.service.OrderService --|> shop.service.Auditable
shop.service.Order --|> shop.model.Entity
shop.service.OrderService *--> shop.service.Repository
shop.service.Order *--> shop.model.Product
shop.service.OrderService --> shop.service.Order
shop.service.OrderService ..> shop.model.Money
shop.service.OrderService ..> shop.model.Product
shop.service.OrderService ..> shop.util.Validator

@enduml