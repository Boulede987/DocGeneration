namespace model.product {
interface Describe <<interface>> {
  + describe() : String
}
interface Priced <<interface>> {
  + price() : Money
  + currency() : Currency
}
class Product {
  + name : String
  - price : Money
  - tags : Tag[*]
  ~ attributes : HashMap<String, String>
  - category : Option<Box<Category>>
  - marker : Rc<Marker>
  ~ code : u32
  + {static} MAX_TAGS : usize
  + {static} new(&str, Money) : Self
  + tag_count() : usize
  - rename(String)
  + describe() : String
  + price() : Money
  + discounted(u32) : Money
}
class Category {
  + label : String
  - parent : Option<Weak<Category>>
  - secret : u8
}
class View {
  + product : &Product
}
class Wrapper<T> {
  + inner : T
  + get() : &T
}
class Sku {
  + 0 : u32
  - 1 : String
}
class Marker {
}
enum Status <<enum>> {
  Draft
  Published
  Archived
  Tagged
}
class Hooks {
  + on_change : fn(Tag) -> Sku
  + callback : Box<dyn Fn(Wrapper<u8>)>
}
}

model.product.Priced --|> model.product.Describe
model.product.Product ..|> model.product.Describe
model.product.Product ..|> model.product.Priced
model.product.Product *--> util.money.Money
model.product.Product *--> "0..*" model.tag.Tag
model.product.Product *--> model.product.Category
model.product.Status *--> model.tag.Tag
model.product.Priced ..> util.money.Money
model.product.Priced ..> util.money.Currency
model.product.Product --> model.product.Marker
model.product.Product ..> util.money.Currency
model.product.Category --> model.product.Category
model.product.View --> model.product.Product