namespace Arena.Data {
class ItemData <<scriptableObject>> {
  + displayName : string
  - icon : Sprite
  + price : int
}
class WeaponData {
  + damage : float
  + projectile : ProjectileSettings
}
class ProjectileSettings {
  + speed : float
  + offset : Vector3
}
}

Arena.Data.WeaponData --|> Arena.Data.ItemData
Arena.Data.WeaponData *--> Arena.Data.ProjectileSettings